@page
@model wt_lab5_5razor_glebko.Pages.Flights.DetailsModel
@{
    ViewData["Title"] = "Детали рейса";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Рейс №@Model.Flight.nomer_reisa</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Город вылета</dt>
                        <dd class="col-sm-8">@Model.Flight.gorod_vilet</dd>

                        <dt class="col-sm-4">Город прилёта</dt>
                        <dd class="col-sm-8">@Model.Flight.gorod_prilet</dd>

                        <dt class="col-sm-4">Время вылета</dt>
                        <dd class="col-sm-8">@Model.Flight.vremya_vileta.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Цена</dt>
                        <dd class="col-sm-8"><span class="fs-4 fw-bold text-primary">@Model.Flight.cena руб.</span></dd>

                        <dt class="col-sm-4">Свободных мест</dt>
                        <dd class="col-sm-8">@Model.Flight.mesta</dd>

                        <dt class="col-sm-4">Статус продажи</dt>
                        <dd class="col-sm-8">
                            @if (Model.Flight.dostupno)
                            {
                                <span class="badge bg-success">Открыта</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Закрыта</span>
                            }
                        </dd>
                    </dl>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-page="/Flights/Edit" asp-route-id="@Model.Flight.nomer_reisa" class="btn btn-warning">Редактировать</a>
                        <a asp-page="/Flights/Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>